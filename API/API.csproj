<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>disable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <!-- Lets the test project reach internal members. Used for the parts of the reporting subsystem that
       are worth testing directly but should not be public API: command construction in the Oracle
       provider, cursor reading, and type mapping. -->
  <ItemGroup>
    <InternalsVisibleTo Include="API.Tests" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.OpenApi" Version="10.0.10" />
    <PackageReference Include="Microsoft.EntityFrameworkCore.Design" Version="10.0.10">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
    <PackageReference Include="Microsoft.EntityFrameworkCore.Sqlite" Version="10.0.10" />
    <PackageReference Include="Swashbuckle.AspNetCore" Version="10.2.3" />
    <!-- Pinned above the version EF Core 10.0.10 pulls in transitively, which trips NU1903
         (GHSA-2m69-gcr7-jv3q, high severity). Remove once EF Core ships a bundle >= 3.0.5. -->
    <PackageReference Include="SQLitePCLRaw.bundle_e_sqlite3" Version="3.0.5" />
  </ItemGroup>

  <!-- Reporting subsystem, MIT licensed. See API/Reporting/THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <PackageReference Include="DynamicExpresso.Core" Version="2.19.3" />
    <PackageReference Include="PuppeteerSharp" Version="25.4.0" />
  </ItemGroup>

  <!-- The one non-MIT dependency, and unavoidable: there is no MIT Oracle driver for .NET. Free of
       charge but under Oracle's own licence terms, and confined to API/Reporting/Data/Oracle*.cs plus
       the template-storage provider switch. See API/Reporting/THIRD-PARTY-NOTICES.md. -->
  <ItemGroup>
    <PackageReference Include="Oracle.ManagedDataAccess.Core" Version="23.26.300" />
    <PackageReference Include="Oracle.EntityFrameworkCore" Version="10.23.26300" />
  </ItemGroup>

  <!-- Builds the React client into wwwroot so a single published site serves both. See DEPLOY-IIS.md.

       Publish only, never on plain build: this shells out to npm, and a normal `dotnet build` or
       `dotnet test` should not depend on Node being installed. Set -p:BuildClient=false to skip it when
       publishing the API alone. -->
  <PropertyGroup>
    <BuildClient Condition="'$(BuildClient)' == ''">true</BuildClient>
    <ClientDirectory>$(MSBuildProjectDirectory)/../client</ClientDirectory>
  </PropertyGroup>

  <Target Name="BuildReactClient" BeforeTargets="PrepareForPublish" Condition="'$(BuildClient)' == 'true'">
    <!-- Degrade to a warning rather than failing the publish: someone publishing on a machine without
         Node still gets a working API, just without the bundled client. -->
    <Exec Command="npm --version" ContinueOnError="true" StandardOutputImportance="low" StandardErrorImportance="low">
      <Output TaskParameter="ExitCode" PropertyName="NpmExitCode" />
    </Exec>

    <Warning Condition="'$(NpmExitCode)' != '0'"
             Text="npm was not found, so the React client was not built into wwwroot. The published API will serve no UI. Install Node, or pass -p:BuildClient=false to silence this." />
    <Warning Condition="'$(NpmExitCode)' == '0' AND !Exists('$(ClientDirectory)/package.json')"
             Text="No client/package.json at $(ClientDirectory), so the React client was not built into wwwroot." />

    <PropertyGroup>
      <ShouldBuildClient Condition="'$(NpmExitCode)' == '0' AND Exists('$(ClientDirectory)/package.json')">true</ShouldBuildClient>
    </PropertyGroup>

    <!-- CI=false because create-react-app promotes lint warnings to errors when CI is set, which is a
         surprising way for a deployment to fail. -->
    <Exec Condition="'$(ShouldBuildClient)' == 'true'"
          Command="npm ci --no-audit --no-fund" WorkingDirectory="$(ClientDirectory)" />
    <Exec Condition="'$(ShouldBuildClient)' == 'true'"
          Command="npm run build" WorkingDirectory="$(ClientDirectory)" EnvironmentVariables="CI=false" />

    <ItemGroup Condition="'$(ShouldBuildClient)' == 'true'">
      <ClientBuildOutput Include="$(ClientDirectory)/build/**/*" />
    </ItemGroup>

    <!-- Copied into wwwroot and then picked up as content, so it lands in the publish output. -->
    <Copy Condition="'$(ShouldBuildClient)' == 'true'"
          SourceFiles="@(ClientBuildOutput)"
          DestinationFiles="@(ClientBuildOutput->'$(MSBuildProjectDirectory)/wwwroot/%(RecursiveDir)%(Filename)%(Extension)')"
          SkipUnchangedFiles="true" />

    <ItemGroup Condition="'$(ShouldBuildClient)' == 'true'">
      <Content Include="wwwroot/**/*" CopyToPublishDirectory="PreserveNewest" Exclude="@(Content)" />
    </ItemGroup>
  </Target>

</Project>
